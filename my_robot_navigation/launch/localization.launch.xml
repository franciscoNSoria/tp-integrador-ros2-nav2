<launch>
  <!-- Argumentos configurables -->
  <arg name="use_sim_time" default="true" />
  
  <!-- Rutas a los archivos de configuración y mapa -->
  <let name="nav2_config" value="$(find-pkg-share my_robot_navigation)/config/nav2_acml.yaml"/>
  <let name="map_path" value="$(find-pkg-share my_robot_navigation)/maps/my_living.yaml" />

  <include file="$(find-pkg-share my_robot_bringup)/launch/bringup.launch.xml"/>
  
  <node pkg="nav2_map_server" exec="map_server" name="map_server" output="screen">
        <param from="$(var nav2_config)"/>
        <param name="yaml_filename" value="$(var map_path)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node pkg="nav2_amcl" exec="amcl" name="amcl" output="screen">
        <param from="$(var nav2_config)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

</launch>
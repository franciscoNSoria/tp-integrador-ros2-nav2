<launch>
    <!-- Argumentos para usar tiempo de simulación y path de parámetros de config slam -->
    <arg name="use_sim_time" default="true" />
    <arg name="slam_config" default="$(find-pkg-share my_robot_mapping)/config/slam_toolbox.yaml" />
    
    <!-- Nodo slam toolbox con parámetro de config y tiempo de sim -->
    <node pkg="slam_toolbox" exec="sync_slam_toolbox_node" name="slam_toolbox" output="screen">
        <param from="$(var slam_config)" />
        <param name="use_sim_time" value="$(var use_sim_time)" />
    </node>
    
    <!-- Nodo map_server -->
    <node pkg="nav2_map_server" exec="map_saver_server" name="map_saver_server" output="screen">
    <!-- Tiempo máximo de espera al guardar el mapa -->
        <param name="save_map_timeout" value="5.0" />
        <param name="use_sim_time" value="$(var use_sim_time)" />
    
        <!-- Parámetros de umbrales de celdas libres/ocupadas/desconocidos -->
        <param name="free_thresh_default" value="0.196" />
        <param name="occupied_thresh_default" value="0.65" />
    </node>

    <!-- Lifecycle manager configura y activa automáticamente map_server y slam_toolbox -->
    <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="lifecycle_manager" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)" />
        <param name="autostart" value="true" />
        <param name="node_names" value="['map_saver_server', 'slam_toolbox']" />
        <param name="bond_timeout" value="10.0"/>
    </node>
</launch>